# Environment variable template for notes_backend

DJANGO_SECRET_KEY=change-this-to-a-very-secret-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=.kavia.ai,localhost,127.0.0.1,testserver

# SQLite default:
SQL_ENGINE=django.db.backends.sqlite3
SQL_DATABASE=db.sqlite3

# For Postgres/MySQL, set these as needed:
SQL_USER=
SQL_PASSWORD=
SQL_HOST=
SQL_PORT=
